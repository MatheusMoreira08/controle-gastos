# ==============================================================
# FINANCEFLOW — VARIÁVEIS DE AMBIENTE
# Copie este arquivo para .env.local e preencha com seus dados.
# NUNCA commite o .env.local no Git!
# ==============================================================
#
# Como obter estas credenciais:
# 1. Acesse https://console.firebase.google.com
# 2. Selecione seu projeto → ⚙️ Configurações → Gerais
# 3. Role até "Seus aplicativos" → selecione o app Web
# 4. Copie os valores do bloco firebaseConfig

VITE_FIREBASE_API_KEY=sua-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto-id
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# ==============================================================
# USUÁRIOS AUTORIZADOS
# Emails que terão acesso ao app (sem espaços)
# ==============================================================
VITE_USER_MATHEUS_EMAIL=email-do-matheus@gmail.com
VITE_USER_VITORIA_EMAIL=email-da-vitoria@gmail.com
